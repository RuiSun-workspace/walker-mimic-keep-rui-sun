   "path": "effects/impact_burst.tscn",
   "start_line": 77,
   "end_line": 88,
   "text": "[node name=\"Flash\" type=\"GPUParticles2D\" parent=\".\"]\nmaterial = SubResource(\"CanvasItemMaterial_flash\")\nemitting = false\namount = 10\ntexture = ExtResource(\"1_dot\")\nlifetime = 0.28\none_shot = true\npreprocess = 0.0\nexplosiveness = 1.0\nlocal_coords = false\nvisibility_rect = Rect2(-64, -64, 128, 128)\nprocess_material = SubResource(\"ParticleProcessMaterial_flash\")"
  },
  {
   "beat_id": "B10",
   "path": "effects/burning_embers_driver.gd",
   "start_line": 27,
   "end_line": 40,
   "text": "func _process(delta: float) -> void:\n\tif _tail_left >= 0.0:\n\t\t_tail_left -= delta\n\t\tif _tail_left <= 0.0:\n\t\t\tqueue_free()\n\t\treturn\n\tif _scarecrow == null:\n\t\treturn\n\t_set_ratio(clampf(_scarecrow.burn_time_left / Tuning.BURN_DURATION, 0.0, 1.0))\n\n\nfunc _on_burning_started() -> void:\n\t_set_ratio(1.0)\n\t_set_emitting(true)"
  },
  {
   "beat_id": "B14",
   "path": "shaders/particles_generated.gdshader",
   "start_line": 316,
   "end_line": 329,
   "text": "\t\tforce = gravity;\n\t\t// Apply linear acceleration.\n\t\tforce += length(USERDATA1.xyz) > 0.0 ? normalize(USERDATA1.xyz) * physics_params.linear_accel : vec3(0.0);\n\t\t// Apply radial acceleration.\n\t\tvec3 org = EMISSION_TRANSFORM[3].xyz;\n\t\tvec3 diff = pos - org;\n\t\tforce += length(diff) > 0.0 ? normalize(diff) * physics_params.radial_accel : vec3(0.0);\n\t\t// Apply tangential acceleration.\n\t\tfloat tangent_accel_val = physics_params.tangent_accel;\n\t\tforce += length(diff.yx) > 0.0 ? vec3(normalize(diff.yx * vec2(-1.0, 1.0)), 0.0) * tangent_accel_val : vec3(0.0);\n\t\tforce += ATTRACTOR_FORCE;\n\t\tforce.z = 0.0;\n\t\t// Apply attractor forces.\n\t\tUSERDATA1.xyz += force * DELTA;"
  }
 ],
