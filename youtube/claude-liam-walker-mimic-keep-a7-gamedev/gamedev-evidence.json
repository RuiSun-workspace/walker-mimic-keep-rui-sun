   "beat_id": "B04",
   "path": "game/scarecrow.tscn",
   "start_line": 18,
   "end_line": 31,
   "text": "length = 0.5\nloop_mode = 1\nstep = 0.125\ntracks/0/type = \"value\"\ntracks/0/imported = false\ntracks/0/enabled = true\ntracks/0/path = NodePath(\"Sprite:frame\")\ntracks/0/interp = 1\ntracks/0/loop_wrap = true\ntracks/0/keys = {\n\"times\": PackedFloat32Array(0, 0.125, 0.25, 0.375),\n\"transitions\": PackedFloat32Array(1, 1, 1, 1),\n\"update\": 1,\n\"values\": [0, 1, 2, 3]"
  },
  {
   "beat_id": "B08",
   "path": "game/archer.tscn",
   "start_line": 75,
   "end_line": 88,
   "text": "length = 0.5\nstep = 0.033333335\ntracks/0/type = \"value\"\ntracks/0/imported = false\ntracks/0/enabled = true\ntracks/0/path = NodePath(\"Rig/BowPivot:rotation\")\ntracks/0/interp = 1\ntracks/0/loop_wrap = true\ntracks/0/keys = {\n\"times\": PackedFloat32Array(0, 0.26666668, 0.3, 0.5),\n\"transitions\": PackedFloat32Array(2, 1, 0.5, 1),\n\"update\": 0,\n\"values\": [0.0, -0.27925268, 0.034906585, 0.0]\n}"
  },
  {
   "beat_id": "B11",
   "path": "game/archer.gd",
   "start_line": 27,
   "end_line": 40,
   "text": "func _physics_process(delta: float) -> void:\n\tvar axis := Input.get_axis(\"move_left\", \"move_right\")\n\tposition.x = clampf(position.x + axis * Tuning.ARCHER_SPEED * delta,\n\t\t\tTuning.ARCHER_MARGIN, Tuning.VIEW.x - Tuning.ARCHER_MARGIN)\n\tfire_cooldown = maxf(fire_cooldown - delta, 0.0)\n\tif shot_armed:\n\t\tif release_window:\n\t\t\t# Active frame: the arrow goes even if the target was lost on this same tick (§5.5).\n\t\t\tvar aim := locked_target.global_position if is_instance_valid(locked_target) else _locked_pos\n\t\t\t_fire_at(aim)\n\t\t\tfire_cooldown = Tuning.FIRE_INTERVAL\n\t\t\tshot_armed = false\n\t\t\tlocked_target = null\n\t\telif not _target_held():"
  },
  {
   "beat_id": "B13",
   "path": "game/scarecrow_walk_presenter.gd",
   "start_line": 2,
   "end_line": 15,
   "text": "## Presentation only (CHANGE-BRIEF §1, revision 1.4): picks which clip Scarecrow/AnimationPlayer plays\n## from the scarecrow's at_wall. walk while it advances, hold (frame 0) once it hits the gate.\n## Reads game state, never writes it; never writes Sprite.frame (the AnimationPlayer is its one writer).\n## Compares against assigned_animation, not current_animation: hold is a one-key LOOP_NONE clip, so\n## current_animation turns \"\" once it ends and would otherwise make this call play() every frame.\n\n@onready var _scarecrow: Scarecrow = get_parent() as Scarecrow\n@onready var _player: AnimationPlayer = $\"../AnimationPlayer\"\n\n\nfunc _process(_delta: float) -> void:\n\tvar clip := &\"hold\" if _scarecrow.at_wall else &\"walk\"\n\tif _player.assigned_animation != clip:\n\t\t_player.play(clip)"
  }
 ],
